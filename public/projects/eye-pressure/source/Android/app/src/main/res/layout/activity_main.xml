<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scanning_devices"
        android:textSize="18sp"
        android:layout_marginBottom="24dp"
        android:textColor="@color/colorPrimary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/deviceInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:padding="16dp"
        android:background="@color/colorPrimary"
        android:layout_marginBottom="24dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/asciiInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="@color/colorConnected"
        android:background="#f0f8ff"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        android:gravity="center" />

    <LinearLayout
        android:id="@+id/connectionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnYes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_yes"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/colorConnected" />

        <Button
            android:id="@+id/btnNo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_no"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/colorDisconnected" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnScan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_scan"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_connect"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <EditText
        android:id="@+id/voltageInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="电压 (0.036-1.80V)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:id="@+id/buttonGrid">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnSetVoltage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="设置电压"
                android:layout_marginEnd="4dp"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/colorPrimary" />

            <Button
                android:id="@+id/btnViewLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="查看日志"
                android:layout_marginStart="4dp"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/colorAccent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCloseVoltage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="关闭电压输出"
                android:layout_marginEnd="4dp"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/colorDisconnected" />

            <Button
                android:id="@+id/btnReadDevice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="读取设备信息"
                android:layout_marginStart="4dp"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/colorConnected" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/dataLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text=""
        android:textSize="12sp"
        android:background="#f0f0f0"
        android:padding="8dp"
        android:scrollbars="vertical"
        android:visibility="gone" />

</LinearLayout>
