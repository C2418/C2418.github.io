---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Pagination from "../components/control/Pagination.astro";
import PostPage from "../components/PostPage.astro";
import Hero from "../components/Hero.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrlBySlug, url } from "../utils/url-utils";
export const getStaticPaths = (async ({ paginate }) => paginate(await getSortedPosts(), { pageSize: PAGE_SIZE })) satisfies GetStaticPaths;
interface Props { page: Page<CollectionEntry<"posts">>; }
const { page } = Astro.props;
const isFirstPage = page.currentPage === 1;
const featured = isFirstPage ? (await getSortedPosts()).filter(post => post.data.featured).slice(0, 3) : [];
---
<MainGridLayout title={isFirstPage ? undefined : `文章 · 第 ${page.currentPage} 页`} description="2418 的个人博客，记录自托管、身份认证、嵌入式开发与项目实践。">
    <div class="space-y-10">
        {isFirstPage && <Hero />}
        {featured.length > 0 && <section aria-labelledby="featured-title">
            <h2 id="featured-title" class="text-xl font-bold text-90 mb-4">精选阅读</h2>
            <div class="grid gap-3 md:grid-cols-2">
                {featured.map(post => <a href={getPostUrlBySlug(post.slug)} class="rounded-xl border border-[var(--line-divider)] p-5 hover:bg-[var(--btn-plain-bg-hover)]">
                    <p class="text-xs text-[var(--primary)] mb-2">{post.data.category || '技术笔记'}</p>
                    <h3 class="font-bold text-90 leading-relaxed">{post.data.title}</h3>
                    <p class="text-sm text-75 mt-2 line-clamp-2">{post.data.description}</p>
                </a>)}
            </div>
        </section>}
        <section id="latest" aria-labelledby="latest-title">
            <div class="flex items-center justify-between gap-4 mb-4">
                <h2 id="latest-title" class="text-xl font-bold text-90">{isFirstPage ? '最新文章' : '更多文章'} <span class="text-sm font-normal text-50 ml-2">共 {page.total} 篇</span></h2>
                <a href={url('/archive/')} class="text-sm text-[var(--primary)]">全部归档 →</a>
            </div>
            <PostPage page={page} />
            {page.lastPage > 1 && <Pagination class="mx-auto" page={page} />}
        </section>
    </div>
</MainGridLayout>
