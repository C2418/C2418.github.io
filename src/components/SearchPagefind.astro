---
import { url } from "../utils/url-utils";
---
<dialog id="search-modal" data-index={url('/pagefind/pagefind.js')} class="w-[calc(100%-2rem)] max-w-2xl rounded-2xl p-0 bg-[var(--card-bg)] text-90 shadow-2xl backdrop:bg-black/50" aria-labelledby="search-title">
    <div class="p-5 border-b border-[var(--line-divider)]">
        <div class="flex items-center justify-between mb-4"><h2 id="search-title" class="font-bold">搜索文章</h2><button id="search-close" aria-label="关闭搜索" class="px-3 py-1 rounded-lg btn-plain">✕</button></div>
        <input id="search-input" type="search" aria-label="搜索关键词" placeholder="输入标题、技术或关键词…" class="w-full rounded-lg p-3 bg-[var(--page-bg)] text-90" />
    </div>
    <p id="search-status" role="status" class="px-5 py-3 text-sm text-75">输入关键词开始搜索</p>
    <ul id="search-results" class="max-h-[55vh] overflow-auto px-3 pb-3"></ul>
</dialog>
<script>
const modal = document.querySelector<HTMLDialogElement>('#search-modal')!;
const input = document.querySelector<HTMLInputElement>('#search-input')!;
const results = document.querySelector<HTMLUListElement>('#search-results')!;
const status = document.querySelector<HTMLElement>('#search-status')!;
let generation = 0;
let timer: ReturnType<typeof setTimeout>;
let indexPromise: Promise<any> | undefined;
function loadIndex() {
    return indexPromise ??= import(/* @vite-ignore */ modal.dataset.index!).catch(error => { indexPromise = undefined; throw error; });
}
function close() { modal.close(); }
function open() { if (!modal.open) modal.showModal(); input.focus(); }
document.getElementById('search-trigger')?.addEventListener('click', open);
document.getElementById('search-close')?.addEventListener('click', close);
modal.addEventListener('click', event => { if (event.target === modal) { const rect = modal.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) close(); } });
modal.addEventListener('close', () => { generation++; clearTimeout(timer); input.value = ''; results.replaceChildren(); status.textContent = '输入关键词开始搜索'; document.getElementById('search-trigger')?.focus(); });
document.addEventListener('keydown', event => { if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); modal.open ? close() : open(); } });
input.addEventListener('input', () => {
    clearTimeout(timer);
    const version = ++generation;
    const query = input.value.trim();
    results.replaceChildren();
    status.textContent = query ? '正在搜索…' : '输入关键词开始搜索';
    if (!query) return;
    timer = setTimeout(async () => {
        try {
            const pagefind = await loadIndex();
            const search = await pagefind.search(query);
            const matches = await Promise.all(search.results.slice(0, 8).map((result: any) => result.data()));
            if (version !== generation || !modal.open) return;
            status.textContent = matches.length ? `找到 ${search.results.length} 篇相关文章` : '没有找到相关文章，试试其他关键词。';
            for (const match of matches) {
                const li = document.createElement('li');
                const link = document.createElement('a');
                link.href = match.url;
                link.className = 'block rounded-lg p-3 hover:bg-[var(--btn-plain-bg-hover)]';
                const title = document.createElement('p'); title.className = 'font-bold'; title.textContent = match.meta.title;
                const excerpt = document.createElement('p'); excerpt.className = 'text-sm text-75 mt-1 line-clamp-2';
                excerpt.textContent = new DOMParser().parseFromString(match.excerpt, 'text/html').body.textContent;
                link.append(title, excerpt); li.append(link); results.append(li);
            }
        } catch { if (version === generation) status.textContent = '搜索暂时不可用，请通过归档浏览文章。'; }
    }, 200);
});
</script>
