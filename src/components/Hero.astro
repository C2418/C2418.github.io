---
import { profileConfig } from "@/config";
import { Image } from "astro:assets";
import avatar from "../assets/images/avatar.jpg";
import { url } from "../utils/url-utils";
---
<section class="hero">
    <div>
        <p class="eyebrow">2418 / 技术与实践</p>
        <h1 class="text-90">把想法做出来，<br /><span>把过程记录下来。</span></h1>
        <p class="intro text-75">你好，我是 {profileConfig.name}。这里记录自托管服务、身份认证与嵌入式项目中的探索、实现和踩坑经验。</p>
        <div class="actions">
            <a class="primary" href="#latest">阅读最新文章 <span aria-hidden="true">↓</span></a>
            <a class="secondary" href={url('/about/')}>关于我 <span aria-hidden="true">↗</span></a>
        </div>
        <div class="topics"><span>自托管</span><span>身份认证</span><span>嵌入式开发</span></div>
    </div>
    <Image src={avatar} alt={`${profileConfig.name} 的头像`} width={160} height={160} loading="eager" class="avatar" />
</section>
<style>
.hero { display:flex; align-items:center; justify-content:space-between; gap:2rem; padding:clamp(1.5rem,4vw,3.5rem); border:1px solid var(--line-divider); border-radius:1.5rem; background:linear-gradient(120deg,var(--btn-regular-bg),var(--card-bg)); }
.eyebrow { color:var(--primary); font-size:.8rem; letter-spacing:.14em; font-weight:700; margin-bottom:1.4rem; }
h1 { font-size:clamp(1.8rem,3.5vw,3rem); line-height:1.4; font-weight:800; letter-spacing:-.04em;  }
h1 span { color:var(--primary); }
.intro { max-width:34rem; line-height:1.9; margin-top:1.2rem;  opacity:.75; }
.actions { display:flex; flex-wrap:wrap; gap:.75rem; margin-top:1.8rem; }
.actions a { display:flex; gap:1.5rem; align-items:center; border-radius:.75rem; padding:.8rem 1.1rem; font-weight:600; }
.primary { background:var(--primary); color:var(--card-bg); }
.secondary { color:var(--primary); border:1px solid var(--line-divider); }
.topics { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.8rem; font-size:.8rem; color:var(--primary); }
.avatar { width:8rem; height:8rem; object-fit:cover; border-radius:2rem; transform:rotate(5deg); box-shadow:0 12px 35px #0001; }
@media(max-width:640px) { .avatar { display:none; } }
</style>
